# Copy to .env and replace every "change-me" value. Never commit .env.
POSTGRES_USER=windcast
POSTGRES_PASSWORD=change-me
POSTGRES_DB=windcast

# Compose defaults to production. Fixtures are always disabled in Compose.
WINDCAST_APP_ENV=production
WINDCAST_WORKER_HEARTBEAT_SECONDS=30
WINDCAST_WORKER_STALE_AFTER_SECONDS=120

# GSE national wind aggregate ingestion (issue #3). Keep false until the owner confirms that
# reuse of the public GSE exports is permitted. See docs/sources/gse.md.
WINDCAST_GSE_INGESTION_ENABLED=false
WINDCAST_GSE_POLL_SECONDS=60
# A reading older than this (by its GSE period label) is shown as stale.
WINDCAST_GSE_FRESH_WITHIN_SECONDS=600
# Optional identifying User-Agent for requests to GSE (empty = HTTP library default).
WINDCAST_GSE_USER_AGENT=

# Open-Meteo model weather for the three sites (issue #4). Free API is for non-commercial use;
# confirm the use category before enabling. See docs/sources/weather.md.
WINDCAST_WEATHER_INGESTION_ENABLED=false
WINDCAST_WEATHER_POLL_SECONDS=900
WINDCAST_WEATHER_USER_AGENT=

# Logging level for api and worker (DEBUG, INFO, WARNING).
WINDCAST_LOG_LEVEL=INFO
# Image tag used by compose (set to a release/git SHA for rollback; "local" for dev builds).
WINDCAST_IMAGE_TAG=local

# Host bindings default to loopback so nothing is exposed publicly without a deliberate change.
API_BIND=127.0.0.1
API_PORT=8000
FRONTEND_BIND=127.0.0.1
FRONTEND_PORT=3000

# Optional base-image overrides (e.g. a registry mirror when Docker Hub rate-limits).
# POSTGRES_IMAGE=postgres:17.7-alpine3.22
# PYTHON_IMAGE=python:3.12.12-slim
# NODE_IMAGE=node:22.21.1-alpine3.22
